# Template environment configuration (Commit this to Git)
PORT=8000
NODE_ENV=development

# MongoDB connection string
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# For local MongoDB: mongodb://localhost:27017/<dbname>
MONGODB_URI=

# CORS - Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# JWT Secrets
JWT_SECRET=your_jwt_access_secret_key
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key

